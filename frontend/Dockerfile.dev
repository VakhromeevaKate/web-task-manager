FROM node:20-alpine

WORKDIR /app

# Сначала зависимости — слой кэшируется
COPY package*.json ./
RUN npm ci

# Код скопируем на случай, если volume не смонтирован
COPY . .

EXPOSE 5173

# --host 0.0.0.0 обязателен, иначе Vite слушает только 127.0.0.1 внутри контейнера
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]